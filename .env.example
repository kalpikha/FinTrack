# Firebase web app config (Project Settings → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Admin bootstrap credentials. The app auto-creates this user on first run.
VITE_ADMIN_NAME=Admin
VITE_ADMIN_EMAIL=admin@fintrack.local
VITE_ADMIN_PASSWORD=Admin@123456

# Firebase App Check (optional but recommended for production).
# Get a reCAPTCHA Enterprise site key from Google Cloud Console and register
# it under Firebase Console → App Check → Web apps. Leave empty to disable.
VITE_RECAPTCHA_SITE_KEY=

# Optional: paste a debug token from the Firebase console here when running on
# a machine the reCAPTCHA provider can't attest (CI, headless tests).
# If left empty in dev, the SDK auto-prints a debug token to the console.
VITE_APPCHECK_DEBUG_TOKEN=
